package todos

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"net/http"
	"strconv"
	"strings"

	"howl-go/client/dom"
	"howl-go/client/store"
	"howl-go/client/ui"
)


templ Page() {
	<section class="page">
		<h1>The store runs in the browser</h1>
		<p class="lede">
			SSR'd from Go memory, then the same <code>store.Store</code> — compiled to
			wasm — takes over. Adds and deletes mutate locally and re-render locally;
			the server is told afterwards and never blocks you.
		</p>
		<form class="todo-form" method="post" action="/api/todos" data-todo-form>
			<input name="text" placeholder="add a todo…" autocomplete="off" required data-todo-input/>
			<button type="submit">Add</button>
		</form>
		@Counter(store.TodosFrom(ctx))
		<ul class="todos" id="todo-list">
			@ui.TodoList(store.TodosFrom(ctx))
		</ul>
		<p class="hint" id="todo-count">{ fmt.Sprintf("%d item(s) in server memory", len(store.TodosFrom(ctx))) }</p>
	</section>
}

// ---------------------------------------------------------------------------
// This page has no JavaScript island. Mount hydrates the browser store, renders
// with the same templ component the server uses, and wires the handlers — all
// in Go. Unmount releases the subscription, which is the entire reason it
// exists: a subscription that outlives its DOM keeps firing against nodes that
// were thrown away, and every visit adds another one.
// ---------------------------------------------------------------------------

var cancelSub func()

func Mount() {
	root := dom.Root()

	// Any handler can reach the browser's store directly — it is a
	// package-level instance, not something threaded through a component tree.
	root.Query("[data-add]").On("click", func() {
		mutate(store.Op{Kind: "add", Text: "added from a Go click handler"})
	})
	root.Query("[data-todo-form]").On("submit", func() {
		text := strings.TrimSpace(root.Query("[data-todo-input]").Value())
		if text == "" {
			return
		}
		mutate(store.Op{Kind: "add", Text: text})
		root.Query("[data-todo-input]").SetValue("")
	})

	// Mutations notify subscribers, so no handler needs to know how to repaint.
	// This is the only place that does.
	cancelSub = store.Subscribe(repaint)

	// Hydrate from the server, then render from the local store.
	go func() {
		res, err := http.Get("/api/todos")
		if err != nil {
			dom.Warn("[todos] hydrate failed:", err.Error())
			return
		}
		defer res.Body.Close()
		var sn store.Snapshot
		if err := json.NewDecoder(res.Body).Decode(&sn); err != nil {
			dom.Warn("[todos] decode failed:", err.Error())
			return
		}
		store.Client().Restore(sn) // Restore notifies, which repaints
		dom.Log("[todos] hydrated", len(sn.Items), "items — subscribers:", store.Watchers())
	}()

	dom.Log("[todos] mounted — subscribers:", store.Watchers())
}

func Unmount() {
	if cancelSub != nil {
		cancelSub()
		cancelSub = nil
	}
	dom.Log("[todos] unmounted — subscribers:", store.Watchers())
}

// mutate applies an op locally for an instant repaint, then tells the server.
// The user never waits on the round-trip.
func mutate(op store.Op) {
	store.Client().Apply(op)
	go func() {
		body, _ := json.Marshal([]store.Op{op})
		res, err := http.Post("/api/todos/sync", "application/json", bytes.NewReader(body))
		if err != nil {
			dom.Warn("[todos] sync deferred:", err.Error())
			return
		}
		res.Body.Close()
	}()
}

func repaint() {
	root := dom.Root()
	if !root.Query("#todo-list").Valid() {
		return // page already swapped away
	}
	items := store.Client().List()

	var sb strings.Builder
	if err := ui.TodoList(items).Render(context.Background(), &sb); err != nil {
		dom.Warn("[todos] render failed:", err.Error())
		return
	}
	// Rendered by the same templ component the server uses, inside the browser.
	root.Query("#todo-list").SetHTML(sb.String())
	root.Query("[data-todo-count]").SetText(countText(len(items)))
	root.Query("[data-watchers]").SetText("subscribers: " + itoa(store.Watchers()))

	// Delete buttons are re-created on every repaint, so rebind each time.
	for _, btn := range root.QueryAll("[data-del]") {
		id := btn.Attr("data-del")
		btn.On("click", func() {
			n, err := strconv.Atoi(id)
			if err == nil {
				mutate(store.Op{Kind: "del", ID: n})
			}
		})
	}
}
