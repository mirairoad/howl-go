package pages

import (
	"howl-go/client/router"
	"howl-go/client/ui"
)

// app.templ is the document shell: reserved name, never a route. Rendered only
// for cold requests — SPA fragments get the page + its layouts, not this.
templ App(title, head string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Exactly one <title>: a page's `templ Head()` supplies it when
			     present, otherwise the route label is used. Two title elements
			     and the browser keeps the first, so the page would lose. -->
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<!-- Which routes need the wasm binary, straight from the generated
			     table — so the client never hardcodes a path prefix. -->
			@templ.JSONScript("howl-wasm-routes", router.NeedsWasm(router.Routes(ctx)))
			<script src="/static/app.js" type="module"></script>
			<!--page-head-->
			@templ.Raw(head)
			<!--/page-head-->
		</head>
		<body>
			<header class="topbar">
				<a class="brand" href="/">howl<span>-go</span></a>
				<nav>
					for _, r := range router.Nav(router.Routes(ctx)) {
						@ui.NavLink(r.Pattern, r.Label)
					}
				</nav>
				<!-- Island lives OUTSIDE the outlet: survives SPA nav, dies on reload. -->
				@ui.Island("counter", `{"start":0,"label":"persist"}`) {
					<button class="chip" data-count>persist: 0</button>
				}
			</header>
			<main id="outlet" data-route={ router.Current(ctx) }>
				{ children... }
			</main>
			<footer class="foot"><span id="nav-log">cold load (SSR)</span></footer>
		</body>
	</html>
}

templ NotFound(path string) {
	<section class="page">
		<h1>404</h1>
		<p class="lede">No route for <code>{ path }</code>.</p>
	</section>
}
