package pages

templ Head() {
	<title>Hello — howl-go</title>
	<meta name="description" content="A standalone application importing howl-go from GitHub."/>
}

templ Page() {
	<section>
		<p class="eyebrow">external module</p>
		<h1>Hello from howl-go.</h1>
		<p>This page was discovered from the filesystem and rendered by an imported framework.</p>
	</section>
}
