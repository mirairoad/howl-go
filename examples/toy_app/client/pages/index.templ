package pages

import (
	"github.com/mirairoad/howl-go/examples/toy_app/client/store"
	"github.com/mirairoad/howl-go/examples/toy_app/client/ui"
)


templ Page() {
	<section class="page">
		<h1>Routes come from the filesystem</h1>
		<p class="lede">
			Rendered by Go at <code>{ store.MetaFrom(ctx).RenderedAt }</code>.
			This page is <code>client/pages/index.templ</code>; the table that routes
			to it is generated at build time by <code>tools/fsroutes</code>.
		</p>
		<div class="grid">
			<article class="card">
				<h3>index.templ</h3>
				<p>A directory containing one becomes a route. <code>about/index.templ</code> → <code>/about</code>.</p>
			</article>
			<article class="card">
				<h3>layout.templ</h3>
				<p>Wraps its directory and everything below it, discovered by walking up the tree.</p>
			</article>
			<article class="card">
				<h3>app.templ</h3>
				<p>The document shell. Reserved, never a route, and skipped entirely for SPA fragments.</p>
			</article>
		</div>
		<h2>Client-only state, server-rendered shell</h2>
		@ui.Island("counter", `{"start":10,"label":"page"}`) {
			<button class="chip big" data-count>page: 10</button>
		}
		<p class="hint">Inside the outlet, so it re-hydrates on every navigation — unlike the header counter.</p>
	</section>
}
